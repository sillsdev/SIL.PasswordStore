<Project>
  <PropertyGroup>
    <LangVersion>default</LangVersion>
    <Nullable>enable</Nullable>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">netstandard2.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net462;netstandard2.0;net10.0</TargetFrameworks>
    <Company>SIL Global</Company>
    <Authors>SIL Global</Authors>
    <Product>SIL.PasswordStore</Product>
    <Copyright>Copyright © 2022-2026 SIL Global</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sillsdev/SIL.PasswordStore</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)/SIL.PasswordStore.snk</AssemblyOriginatorKeyFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <AppendToReleaseNotesProperty><![CDATA[
See full changelog at https://github.com/sillsdev/SIL.PasswordStore/blob/master/CHANGELOG.md]]>
    </AppendToReleaseNotesProperty>
    <UseFullSemVerForNuGet>false</UseFullSemVerForNuGet>
  </PropertyGroup>

  <Target Name="EnsureNetFxTarget" BeforeTargets="Pack"
          Condition="'$(IsPackable)' == 'true' and !$(TargetFrameworks.Contains('net462'))">
    <Error Text="net462 must be built when packing; run pack on Windows." />
  </Target>
</Project>